APP_ENV=development
APP_DEBUG=true
TOKEN_TTL_HOURS=72

# Настройки подключения к PostgreSQL
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=spektr
DB_USER=postgres
DB_PASSWORD=your_secret_password_here

